# /etc/garden-api.env — every setting is optional; defaults shown.

# PORT=5000
# GARDEN_API_KEY=            # if set, clients must send it as X-API-Key
# LOG_LEVEL=INFO            # DEBUG logs every request

# LIGHT_PWM_CHIP=/sys/class/pwm/pwmchip0
# LIGHT_PWM_CHANNEL=0        # GPIO18 is PWM channel 0
# LIGHT_FREQUENCY=8000

# PUMP_PIN=24
# PUMP_FREQUENCY=50
# PUMP_DUTY=70               # PWM duty when on; lower may not lift water
# MAX_PUMP_RUN_SECONDS=900   # hard cap on any single pump run

# INA219_ADDRESS=0x40
# SHUNT_OHMS=0.08

# DISTANCE_TRIGGER_PIN=26
# DISTANCE_ECHO_PIN=19
# DISTANCE_SAMPLES=5
# WATER_FULL_CM=5
# WATER_EMPTY_CM=20
# TANK_CAPACITY_GALLONS=5

# UPPER_CAMERA_DEVICE=/dev/video0   # or /dev/gardyn-upper with the udev rule
# LOWER_CAMERA_DEVICE=/dev/video2
# CAMERA_RESOLUTION=640x480
# CAMERA_SKIP_FRAMES=2
